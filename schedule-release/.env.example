# URL of the base portal (used by the 'Back to Portal' link)
VITE_PORTAL_URL=http://localhost:5173

# Data source. Default: mock data in `npm run dev`, live SAP data in the deployed build.
# VITE_USE_MOCK=true

# OData service binding that exposes ZCDS_SCHDULEAGR_HEAD / _ITEM / ZCDS_SCHEDULEAGR_SCH
# (default: /sap/opu/odata/sap/ZSB_PURCAHSE — change if it's a separate binding)
# VITE_SR_ODATA_SERVICE=/sap/opu/odata/sap/ZSB_SCHEDULE_AGREEMENT
